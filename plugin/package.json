{
  "name": "dsh-agent-preset-editor",
  "version": "3.0.1",
  "description": "Edit and create Agent personas inside DeepSeek Harness settings using the official configuration editor",
  "type": "module",
  "main": "lib/index.js",
  "exports": { ".": "./lib/index.js", "./client": "./lib/client.js", "./package.json": "./package.json", "./locale/*.json": "./locale/*.json" },
  "files": ["lib", "cordis.patch.yml", "locale", "icon.svg", "README.md"],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "inject": ["@deepseek-ai/dsh-client-ui-settings", "@deepseek-ai/dsh-client-ui-layout", "@deepseek-ai/dsh-client-connection"] }
  },
  "dependencies": { "@deepseek-ai/schemastery": "^3.18.4" },
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "icon": "./icon.svg",
  "license": "MIT",
  "repository": { "type": "git", "url": "https://github.com/sodakitten/dsh-persona-editor.git" }
}
